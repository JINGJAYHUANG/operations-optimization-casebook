{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/opcase/suite.schema.json",
  "title": "Operations optimization suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "title", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "suite_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "title": {"type": "string", "minLength": 1},
    "cases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "\\.json$"}}
  }
}
